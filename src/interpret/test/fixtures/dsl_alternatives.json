{
  "_doc": "Shared cases for a fact given as disagreeing alternatives (facts['alt:<name>'], a CONFLICT star-dignity cell). Read by engine/tests/test_dsl_alternatives.py and src/interpret/test/engine.test.ts, so the Python evaluator and its TS port answer them identically. TRUE when every alternative satisfies the condition, FALSE when none does, else UNKNOWN (null); a null alternative is an unknown reading.",
  "cases": [
    {"why": "both readings bright (Toàn Thư Thái Âm at Tý: phú vượng, Hi Di đắc)", "facts": {"palace.dignity.Thái Âm": "unspecified", "alt:palace.dignity.Thái Âm": ["vượng", "đắc"]},
     "expr": {"fact": "palace.dignity.Thái Âm", "operator": "in", "value": ["miếu", "vượng", "đắc"]}, "want": true},
    {"why": "no reading is hãm", "facts": {"palace.dignity.Thái Âm": "unspecified", "alt:palace.dignity.Thái Âm": ["vượng", "đắc"]},
     "expr": {"fact": "palace.dignity.Thái Âm", "operator": "in", "value": ["hãm"]}, "want": false},
    {"why": "not over an all-false condition", "facts": {"alt:palace.dignity.Thái Âm": ["vượng", "đắc"]},
     "expr": {"not": {"fact": "palace.dignity.Thái Âm", "operator": "in", "value": ["hãm"]}}, "want": true},
    {"why": "the readings disagree on the condition (vượng / hãm)", "facts": {"palace.dignity.Tham Lang": "unspecified", "alt:palace.dignity.Tham Lang": ["vượng", "hãm"]},
     "expr": {"fact": "palace.dignity.Tham Lang", "operator": "in", "value": ["miếu", "vượng", "đắc"]}, "want": null},
    {"why": "disagreeing readings stay unknown under not", "facts": {"alt:palace.dignity.Tham Lang": ["vượng", "hãm"]},
     "expr": {"not": {"fact": "palace.dignity.Tham Lang", "operator": "eq", "value": "hãm"}}, "want": null},
    {"why": "one reading has no level: never TRUE", "facts": {"palace.dignity.Văn Xương": "unspecified", "alt:palace.dignity.Văn Xương": ["miếu", null]},
     "expr": {"fact": "palace.dignity.Văn Xương", "operator": "in", "value": ["miếu", "vượng", "đắc"]}, "want": null},
    {"why": "one reading has no level: never FALSE either", "facts": {"alt:palace.dignity.Văn Xương": ["miếu", null]},
     "expr": {"fact": "palace.dignity.Văn Xương", "operator": "eq", "value": "hãm"}, "want": null},
    {"why": "the alternatives win over the placeholder level", "facts": {"palace.dignity.Thái Âm": "unspecified", "alt:palace.dignity.Thái Âm": ["miếu", "đắc"]},
     "expr": {"fact": "palace.dignity.Thái Âm", "operator": "eq", "value": "unspecified"}, "want": false},
    {"why": "alternatives without the plain fact", "facts": {"alt:palace.dignity.Thái Âm": ["miếu", "đắc"]},
     "expr": {"fact": "palace.dignity.Thái Âm", "operator": "ne", "value": "hãm"}, "want": true},
    {"why": "an empty list decides nothing", "facts": {"alt:palace.dignity.Thái Âm": []},
     "expr": {"fact": "palace.dignity.Thái Âm", "operator": "in", "value": ["miếu"]}, "want": null},
    {"why": "inside all / any / count", "facts": {"a": 1, "alt:palace.dignity.Thái Âm": ["vượng", "đắc"], "alt:palace.dignity.Tham Lang": ["vượng", "hãm"]},
     "expr": {"all": [{"fact": "a", "value": 1}, {"fact": "palace.dignity.Thái Âm", "operator": "in", "value": ["miếu", "vượng", "đắc"]}]}, "want": true},
    {"why": "any: a decided TRUE beats an UNKNOWN", "facts": {"alt:palace.dignity.Thái Âm": ["vượng", "đắc"], "alt:palace.dignity.Tham Lang": ["vượng", "hãm"]},
     "expr": {"any": [{"fact": "palace.dignity.Tham Lang", "operator": "eq", "value": "hãm"}, {"fact": "palace.dignity.Thái Âm", "operator": "ne", "value": "hãm"}]}, "want": true},
    {"why": "count with one unknown", "facts": {"alt:palace.dignity.Thái Âm": ["vượng", "đắc"], "alt:palace.dignity.Tham Lang": ["vượng", "hãm"]},
     "expr": {"count": [{"fact": "palace.dignity.Tham Lang", "operator": "eq", "value": "hãm"}, {"fact": "palace.dignity.Thái Âm", "operator": "ne", "value": "hãm"}], "operator": "gte", "value": 1}, "want": true},
    {"why": "a ref reads the other palace's alternatives", "facts": {"palace.rel_names": {"opp": "Thiên Di"}}, "world": {"Thiên Di": {"palace.dignity.Thái Âm": "unspecified", "alt:palace.dignity.Thái Âm": ["miếu", "đắc"]}},
     "expr": {"ref": {"palace": "opp", "fact": "palace.dignity.Thái Âm"}, "operator": "in", "value": ["miếu", "vượng", "đắc"]}, "want": true},
    {"why": "a ref to disagreeing readings", "facts": {"palace.rel_names": {"opp": "Thiên Di"}}, "world": {"Thiên Di": {"alt:palace.dignity.Kình Dương": ["vượng", "hãm"]}},
     "expr": {"ref": {"palace": "opp", "fact": "palace.dignity.Kình Dương"}, "operator": "eq", "value": "hãm"}, "want": null},
    {"why": "a plain (VERIFIED) fact is unchanged", "facts": {"palace.dignity.Thái Âm": "hãm"},
     "expr": {"fact": "palace.dignity.Thái Âm", "operator": "in", "value": ["miếu", "vượng", "đắc"]}, "want": false},
    {"why": "a missing fact is still UNKNOWN", "facts": {},
     "expr": {"fact": "palace.dignity.Thái Âm", "operator": "in", "value": ["miếu"]}, "want": null}
  ]
}
