     "when": {
      "fact": "palace.rel.self_stars",
      "operator": "contains_any",
      "value": [
       "Kình Dương",
       "Đà La",
       "Hỏa Tinh",
       "Linh Tinh",
       "Địa Không",
       "Địa Kiếp"
      ]
     }
    },
    {
     "id": "ky_dong_cung",
     "label": "Hóa Kỵ đồng cung với Mệnh",
     "when": {
      "fact": "palace.rel.self_hoa",
      "operator": "contains",
      "value": "Hóa Kỵ"
     }
    }
   ],
   "rescuers": [
    {
     "id": "khoa_dong_cung",
     "label": "Hóa Khoa đồng cung với Mệnh (giải Kỵ)",
