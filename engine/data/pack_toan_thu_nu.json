  {
   "id": "TV_TT_NU_CO_CAT_QUYEN_LOC",
   "system": "tu_vi",
   "schoolId": "vn_dlhc_draft",
   "category": "tt_nu",
   "description": "Tử Vi Đẩu Số Toàn Thư, nữ mệnh ca (paraphrased), cung Mệnh: làm việc giỏi hơn nhiều người, được Quyền Lộc thì vinh hoa (nữ mệnh Thiên Cơ có cát tinh phù trì) [TT p.108]",
   "conditions": {
    "all": [
     {
      "fact": "palace.name",
      "value": "Mệnh"
     },
     {
      "fact": "chart.gender",
      "value": "nữ"
     },
     {
      "fact": "palace.own_major_stars",
      "operator": "contains",
      "value": "Thiên Cơ"
     },
     {
      "fact": "palace.khi.cat_tp",
      "operator": "gte",
      "value": 1
     },
     {
      "fact": "palace.rel.tp_hoa",
      "operator": "contains",
      "value": "Hóa Quyền"
     },
     {
      "fact": "palace.rel.tp_hoa",
      "operator": "contains",
      "value": "Hóa Lộc"
     }
    ]
   },
   "consequences": [
    {
     "kind": "finding",
     "claim": "tt_nu_co_cat_quyen_loc_vinh_hoa",
     "effect": "support",
     "scope": "natal"
    }
   ],
   "exceptions": [],
   "conflictsWith": [],
   "priority": 3,
   "sourceIds": [
    "SRC_TOAN_THU"
   ],
   "reviewStatus": "draft",
   "version": "0.1.0",
   "subject": "palace"
  },
