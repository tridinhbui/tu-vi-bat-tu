{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tu-vi-bat-tu",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  // Workers Logs: console output (model errors from src/chat/llm.ts llmErrorLine, never keys or chart data) is kept and searchable in the
  // dashboard, so a failure is visible after the fact, not only while someone runs wrangler tail
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": { "directory": "./engine/web", "run_worker_first": ["/api/*"] },
  // /api/interpret on, and mode "prose" may use the draft prose cards (none is expert-reviewed yet); the report marks the text as draft
  // TVBT_PAYWALL: "1" cuts each reading to the reader's tier (src/billing/paywall.ts). Owner decision 2026-10-26: "0", every book-checked
  // reading (main part and Đọc sâu) is free and whole for everyone; only Luận riêng and chat past the free allowance cost xu.
  // TVBT_TAROT: "1" opens the Tarot API (src/tarot/route.ts); apply migrations/app/0011_tarot.sql first (docs/TAROT.md). Off by default.
  "vars": { "TVBT_INTERPRET": "1", "TVBT_PROSE_DRAFT": "1", "TVBT_PAYWALL": "0", "TVBT_TAROT": "0",
    // Public OAuth client id (not a secret). The client secret is set with `wrangler secret put GOOGLE_CLIENT_SECRET`.
    "GOOGLE_CLIENT_ID": "373246803608-1ivuob3khnch8hko5h42o4fnj5o46kql.apps.googleusercontent.com" },
  // the deploy's version id: part of the interpretation cache key, so a code change never serves a reading cached by the previous deploy
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "containers": [
    // basic = 1/4 vCPU, 1 GiB (lite, the default, is 1/16 vCPU, 256 MiB: the Western reading took ~8-10 s there). CPU is billed on
    // active use; memory and disk while the container is awake (sleepAfter 10m). Owner choice 2026-10-25. Workers Builds can show a
    // check run as "failure" for a moment and then "success": read the container rollouts before concluding a deploy failed.
    { "class_name": "TvbtContainer", "image": "./Dockerfile", "max_instances": 3, "instance_type": "basic" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TVBT", "class_name": "TvbtContainer" }]
  },
  // Accounts + saved charts (migrations/app): `npx wrangler d1 migrations apply tvbt-app --remote`.
  "d1_databases": [
    { "binding": "DB", "database_name": "tvbt-app", "database_id": "f8af4737-8f71-4abc-8f7c-84daa6bc0f3a", "migrations_dir": "migrations/app" }
  ],
  "exports": {
    "TvbtContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
