{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tu-vi-bat-tu",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": { "directory": "./engine/web", "run_worker_first": ["/api/*"] },
  // /api/interpret on, and mode "prose" may use the draft prose cards (none is expert-reviewed yet); the report marks the text as draft
  // TVBT_PAYWALL: the reading tiers (src/billing/paywall.ts): guests read the first third of each chapter, members the whole main reading,
  // the Đọc sâu part is opened with xu. "0" (or unset) sends every reading whole to everyone.
  "vars": { "TVBT_INTERPRET": "1", "TVBT_PROSE_DRAFT": "1", "TVBT_PAYWALL": "1",
    // Public OAuth client id (not a secret). The client secret is set with `wrangler secret put GOOGLE_CLIENT_SECRET`.
    "GOOGLE_CLIENT_ID": "373246803608-1ivuob3khnch8hko5h42o4fnj5o46kql.apps.googleusercontent.com" },
  // the deploy's version id: part of the interpretation cache key, so a code change never serves a reading cached by the previous deploy
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "containers": [
    // basic = 1/4 vCPU, 1 GiB (lite, the default, is 1/16 vCPU, 256 MiB: the Western reading took ~8 s there, 4 heavy requests up to 15 s).
    // CPU is billed on active use; memory and disk while the container is awake (sleepAfter 10m). Owner choice 2026-10-25.
    { "class_name": "TvbtContainer", "image": "./Dockerfile", "max_instances": 3, "instance_type": "basic" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TVBT", "class_name": "TvbtContainer" }]
  },
  // Accounts + saved charts (migrations/app): `npx wrangler d1 migrations apply tvbt-app --remote`.
  "d1_databases": [
    { "binding": "DB", "database_name": "tvbt-app", "database_id": "f8af4737-8f71-4abc-8f7c-84daa6bc0f3a", "migrations_dir": "migrations/app" }
  ],
  "exports": {
    "TvbtContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
