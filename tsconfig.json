{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/interpret/test",
    "src/horary/test",
    "src/auth/test",
    "src/billing/test",
    "src/chat/test",
    "src/stats/test",
    "src/feedback/test",
    "src/referral/test",
    "src/account/test"
  ]
}
