diff --git a/tools/build_meta.py b/tools/build_meta.py
new file mode 100644
index 0000000..d9db0f6
--- /dev/null
+++ b/tools/build_meta.py
@@ -0,0 +1,21 @@
+"""Generates engine/web/js/meta.json: Vietnamese claim phrases + source titles, served as a static asset (CDN) instead of two API calls
+(/api/claims 230 KB, /api/rules 1.1 MB) on every page load. Run after changing claims_vi.json or any rule pack."""
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent / "engine"
+sys.path.insert(0, str(ROOT))
+from tvbt.knowledge.loader import load_all  # noqa: E402
+
+
+def build() -> dict:
+    _, sources = load_all()
+    return {"claims": json.loads((ROOT / "data" / "claims_vi.json").read_text("utf-8")),
+            "sources": [{"id": s.id, "title": s.title, "verified": bool(s.verified)} for s in sources]}
+
+
+if __name__ == "__main__":
+    out = ROOT / "web" / "js" / "meta.json"
+    out.write_text(json.dumps(build(), ensure_ascii=False, separators=(",", ":")) + "\n", "utf-8")
+    print("wrote", out, out.stat().st_size, "bytes")
